# Loopback services and local persistent storage
PSEUDO_STUDIO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PSEUDO_STUDIO_DATA_DIR=data
PSEUDO_STUDIO_OCI_ENGINE=docker

# Execution quotas (bounded by validation in backend/runtime/runner.py)
PSEUDO_STUDIO_RUN_TIMEOUT_SECONDS=5
PSEUDO_STUDIO_OUTPUT_LIMIT_BYTES=1048576
PSEUDO_STUDIO_MAX_CONCURRENT_RUNS=4
PSEUDO_STUDIO_MEMORY_MB=256
PSEUDO_STUDIO_CPU_LIMIT=1.0
PSEUDO_STUDIO_PIDS_LIMIT=64
