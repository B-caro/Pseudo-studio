(* Pseudo / Studio EBNF v2 — fuente normativa conforme a la sección 4.2. *)
(* NL representa los finales de línea; // inicia un comentario hasta CR o LF. *)
(* No hay declaración de tipo: se infiere number, string o boolean desde el uso. *)

programa        = "Inicio", NL+, { elemento }, "Fin", [ NL+ ] ;
elemento        = sentencia | funcion ;
sentencia       = leer | leer_texto | escribir | asignacion | condicional
                | para | dimension | mientras | retornar | expr_stmt ;
leer            = "Leer", destino, NL+ ;
leer_texto      = "LeerTexto", destino, NL+ ;
escribir        = "Escribir", expresion, { ",", expresion }, NL+ ;
asignacion      = destino, "=", expresion, NL+ ;
destino         = IDENT, [ "[", expresion, "]" ] ;
dimension       = "Dimension", IDENT, "[", expresion, "]", NL+ ;
condicional     = "Si", expresion, "Entonces", NL+,
                  { sentencia }, [ "Sino", NL+, { sentencia } ], "FinSi", NL+ ;
para            = "Para", IDENT, "=", expresion, "Hasta", expresion,
                  [ "Paso", expresion ], "Hacer", NL+,
                  { sentencia }, "FinPara", NL+ ;
mientras        = "Mientras", expresion, "Hacer", NL+,
                  { sentencia }, "FinMientras", NL+ ;
funcion         = "Funcion", [ IDENT, "=" ], IDENT, "(", [ parametros ], ")", NL+,
                  { sentencia }, "FinFuncion", NL+ ;
parametros      = IDENT, { ",", IDENT } ;
retornar        = "Retornar", expresion, NL+ ;
expr_stmt       = llamada, NL+ ;

expresion       = disyuncion ;
disyuncion      = conjuncion, { "O", conjuncion } ;
conjuncion      = igualdad, { "Y", igualdad } ;
igualdad        = relacion, { ("==" | "!="), relacion } ;
relacion        = aditiva, { (">" | "<" | ">=" | "<="), aditiva } ;
aditiva         = multiplicativa, { ("+" | "-"), multiplicativa } ;
multiplicativa  = unaria, { ("*" | "/" | "%" | "Modulo"), unaria } ;
unaria          = ("-" | "+" | "No"), unaria | primaria ;
primaria        = NUM | STRING | "Verdadero" | "Falso" | referencia
                | llamada | "(", expresion, ")" ;
referencia      = IDENT, [ "[", expresion, "]" ] ;
llamada         = IDENT, "(", [ argumentos ], ")" ;
argumentos      = expresion, { ",", expresion } ;

(* Reglas léxicas concretas del lexer implementado: *)
(* DIGITO = uno de "0"..."9"; solo se aceptan dígitos ASCII en literales numéricos. *)
(* ENTERO = DIGITO, { DIGITO }. *)
(* DECIMAL = DIGITO, { DIGITO }, ".", DIGITO, { DIGITO } *)
(*         | ".", DIGITO, { DIGITO }. *)
(* NUM = ENTERO | DECIMAL; no admite coma decimal ni exponente. El signo usa unaria. *)
(* IDENT inicia con letra Unicode (categoría L) o "_"; continúa con L, marcas M, *)
(*       números Unicode N o "_". Los identificadores se normalizan a Unicode NFC. *)
(* STRING abre y cierra con U+0022; no admite saltos de línea literales. *)
(*       U+005C escapa U+005C, U+0022, "n" (LF) o "t" (tabulación). *)
(* COMENTARIO inicia con "//" y consume hasta CR/LF; no produce token. *)
(* Las palabras reservadas se comparan sin distinguir mayúsculas; IDENT sí distingue. *)
(* NL+ puede omitir líneas vacías y líneas de comentario puro. Fin puede llegar a EOF. *)

(* Categorías semánticas: number (ENTERO y DECIMAL), string (STRING), boolean *)
(* (Verdadero/Falso); los arreglos son contenedores con tipo de elemento inferido. *)
(* ENTERO y DECIMAL son formas léxicas, no tipos numéricos estáticos separados: *)
(* ambos pertenecen a number IEEE-754 finito. Dimension e índices requieren *)
(* un entero seguro; Leer lee number y LeerTexto lee string. *)
